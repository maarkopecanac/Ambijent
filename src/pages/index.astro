  <!-- JavaScript za hamburger meni -->
  <script>
  document.addEventListener('DOMContentLoaded', function() {
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');

    if (toggle && menu) {
      // Otvori/zatvori meni na klik hamburgera
      toggle.addEventListener('click', function() {
        menu.classList.toggle('hidden');
      });

      // Zatvori meni kada se klikne na bilo koji link u meniju
      const menuLinks = menu.querySelectorAll('a');
      menuLinks.forEach(link => {
        link.addEventListener('click', function() {
          menu.classList.add('hidden');
        });
      });
    }
  });
</script>

  <script>
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.querySelector('form[action*="formspree"]');
    if (!form) return;

    form.addEventListener('submit', function(e) {
      e.preventDefault(); // SPRIJEČI PREUSMJERAVANJE
      
      const formData = new FormData(form);
      
      fetch(form.action, {
        method: 'POST',
        body: formData,
        headers: {
          'Accept': 'application/json'
        }
      }).then(response => {
        if (response.ok) {
          // Sakrij formu
          form.style.display = 'none';
          // Prikaži poruku
          const messageDiv = document.createElement('div');
          messageDiv.className = 'text-center py-10';
          messageDiv.innerHTML = `
            <svg class="w-16 h-16 text-green-500 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <h3 class="text-2xl font-bold text-gray-900">Poruka je uspješno poslana! Hvala vam.</h3>
            <p class="text-gray-600 mt-2">Odgovoriti ćemo vam u najkraćem mogućem roku.</p>
          `;
          form.parentNode.appendChild(messageDiv);
        } else {
          alert('Došlo je do greške. Pokušajte ponovo.');
        }
      }).catch(error => {
        alert('Došlo je do greške. Pokušajte ponovo.');
        console.error('Greška:', error);
      });
    });
  });
</script>

<script>
  let lastScrollTop = 0;
  const navbar = document.querySelector('nav');
  let ticking = false;

  function onScroll() {
    const scrollTop = window.pageYOffset || document.documentElement.scrollTop;

    if (scrollTop > 100 && scrollTop > lastScrollTop) {
      // Skrolovanje prema dolje - sakrij (brzo)
      navbar.classList.add('nav-hidden');
    } else {
      // Skrolovanje prema gore ili na vrhu - prikaži (sporo, glatko)
      navbar.classList.remove('nav-hidden');
    }

    lastScrollTop = scrollTop <= 0 ? 0 : scrollTop;
    ticking = false;
  }

  window.addEventListener('scroll', function() {
    if (!ticking) {
      window.requestAnimationFrame(onScroll);
      ticking = true;
    }
  });
</script>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const navbar = document.getElementById('navbar');
    if (!navbar) return;

    window.addEventListener('scroll', function() {
      const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
      
      if (scrollTop > 80) {
        // Skrolovano - bijela navigacija
        navbar.classList.remove('nav-transparent');
        navbar.classList.add('nav-solid');
      } else {
        // Na vrhu - transparentna
        navbar.classList.remove('nav-solid');
        navbar.classList.add('nav-transparent');
      }
    });
  });
</script>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const links = document.querySelectorAll('.nav-link');

    const sections = [
      { id: 'top', index: 0 },
      { id: 'ponuda', index: 1 },
      { id: 'o-nama', index: 2 },
      { id: 'cta', index: 2 },     // CTA pripada O NAMA (index 2)
      { id: 'kontakt', index: 3 }
    ];

    let lastActiveIndex = -1;

    function removeActiveClasses() {
      links.forEach(link => link.classList.remove('active-link'));
    }

    function addActiveClass(index) {
      if (links[index]) {
        links[index].classList.add('active-link');
      }
    }

    function getActiveSection() {
      const scrollPos = window.scrollY + 120;
      let current = 0; // default: Početna

      for (const s of sections) {
        const el = document.getElementById(s.id);
        if (!el) continue;

        if (el.offsetTop - 50 <= scrollPos) {
          current = s.index;
        }
      }

      return current;
    }

    let isScrolling = false;

    function handleScroll() {
      const currentIndex = getActiveSection();

      if (currentIndex !== lastActiveIndex) {
        removeActiveClasses();
        addActiveClass(currentIndex);
        lastActiveIndex = currentIndex;
      }
    }

    window.addEventListener('scroll', function() {
      if (!isScrolling) {
        window.requestAnimationFrame(function() {
          handleScroll();
          isScrolling = false;
        });
        isScrolling = true;
      }
    });

    setTimeout(function() {
      handleScroll();
    }, 100);
  });
</script>

