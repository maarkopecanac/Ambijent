---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div id="top"></div>

  <!-- NAVIGACIJA (transparentna, preko slike) -->
  <nav id="navbar" class="fixed top-0 left-0 right-0 z-50 nav-transparent">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    <div class="flex justify-between items-center h-16">
      <!-- Logo -->
      <div class="flex items-center">
        <img src="/logo.png" alt="Ambijent logo" class="h-16 w-auto" />
      </div>
      
      <!-- Desktop meni -->
      <div class="hidden md:flex space-x-1">
        <a href="#top" class="nav-link font-medium transition px-3 py-1.5 rounded-lg">Početna</a>
        <a href="#ponuda" class="nav-link font-medium transition px-3 py-1.5 rounded-lg">Proizvodi</a>
        <a href="#o-nama" class="nav-link font-medium transition px-3 py-1.5 rounded-lg">O nama</a>
        <a href="#kontakt" class="nav-link font-medium transition px-3 py-1.5 rounded-lg">Kontakt</a>
      </div>

      <!-- Hamburger meni -->
      <div class="md:hidden ml-auto">
        <button id="menu-toggle" class="hamburger-icon p-2 hover:bg-white/20 rounded-lg transition">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobilni meni -->
    <div id="mobile-menu" class="md:hidden hidden bg-white shadow-lg rounded-xl absolute top-16 right-4 w-64">
      <div class="flex flex-col space-y-1 py-2">
        <a href="#top" class="text-gray-800 hover:text-[#4d5eab] hover:bg-gray-50 font-medium transition px-4 py-3 rounded-lg">Početna</a>
        <a href="#ponuda" class="text-gray-800 hover:text-[#4d5eab] hover:bg-gray-50 font-medium transition px-4 py-3 rounded-lg">Proizvodi</a>
        <a href="#o-nama" class="text-gray-800 hover:text-[#4d5eab] hover:bg-gray-50 font-medium transition px-4 py-3 rounded-lg">O nama</a>
        <a href="#kontakt" class="text-gray-800 hover:text-[#4d5eab] hover:bg-gray-50 font-medium transition px-4 py-3 rounded-lg">Kontakt</a>
      </div>
    </div>
  </div>
</nav>

  <!-- HERO SEKCIJA (slika počinje od vrha) -->
  <section class="min-h-screen flex items-center relative">
    <!-- Pozadinska slika -->
    <div class="absolute inset-0 z-0">
      <img 
        src="/kuhinja.jpeg"  
        alt="Moderna kuhinja" 
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-black/50"></div>
    </div>
    
    <!-- Sadržaj preko slike -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="max-w-2xl md:max-w-2xl mx-auto md:mx-0 text-center md:text-left">
      <h1 class="text-4xl md:text-6xl font-bold text-white leading-tight mb-6">
        Okovi za izradu <br>
        namještaja i <br>
        sobnih vrata
      </h1>
      <p class="text-xl text-white/90 mb-8 max-w-lg mx-auto md:mx-0">
        Prodaja okova za izradu namještaja i sobnih vrata, opreme za enterijer i materijala za uređenje prostora. Višegodišnje iskustvo u prodaji, širok asortiman na stanju i brza isporuka za stolare i proizvođače namještaja.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center md:justify-start">
        <a href="#kontakt-forma" class="bg-[#4d5eab] text-white px-8 py-4 rounded-lg font-semibold hover:bg-[#3d4e8a] transition text-center shadow-lg shadow-[#4d5eab]/30">
          Kontaktirajte nas
        </a>
      </div>
    </div>
  </div>
  </section>

  <!-- SEKCIJA: Naša ponuda (brendovi) -->
  <section id="ponuda" class="py-20 bg-gray-50">
  	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <span class="text-[#4d5eab] font-semibold text-sm uppercase tracking-wider">Naša ponuda</span>
        <h2 class="text-4xl font-bold text-gray-900 mt-2">Vrhunski okovi za svaki vaš projekat</h2>
        <p class="text-gray-600 mt-4 max-w-2xl mx-auto">
          Širok asortiman okova za sobna vrata, kuhinje, ormare i sav namještaj po mjeri.
        </p>
      </div>

      <!-- Kratak opis vrsta okova -->
      <!-- Kratak opis vrsta okova -->
      <div class="max-w-3xl mx-auto text-center mb-12">
        <p class="text-gray-700 text-lg">
          U našoj ponudi nalaze se okovi za namještaj renomiranih evropskih proizvođača: šarke, kvake, brave, vodilice, klizni sistemi, mehanizmi na dodir ili sa ublaživačem, sudoperi, slavine, sistemi za odvajanje otpada i mnogi drugi kvalitetni okovi za vaš namještaj.
        </p>
      </div>

      <!-- Logoovi brendova -->
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 items-center">
        <!-- BLUM -->
		<div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition flex items-center justify-center h-24">
			<img src="/brendovi/Blum.png" alt="BLUM" class="h-16 w-auto object-contain" loading="lazy" />
		</div>
		<!-- GTV -->
		<div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition flex items-center justify-center h-24">
			<img src="/brendovi/GTV.png" alt="GTV" class="h-18 w-auto object-contain" loading="lazy" />
		</div>
		<!-- SIGE -->
		<div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition flex items-center justify-center h-24">
			<img src="/brendovi/SIGE.png" alt="SIGE" class="h-12 w-auto object-contain" loading="lazy" />
		</div>
		<!-- INOXA -->
		<div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition flex items-center justify-center h-24">
			<img src="/brendovi/INOXA.png" alt="INOXA" class="h-28 w-auto object-contain" loading="lazy" />
		</div>
		<!-- AGB -->
		<div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition flex items-center justify-center h-24">
			<img src="/brendovi/AGB.png" alt="AGB" class="h-20 w-auto object-contain" loading="lazy" />
		</div>
		<!-- BLANCO -->
		<div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition flex items-center justify-center h-24">
			<img src="/brendovi/BLANCO.png" alt="BLANCO" class="h-8 w-auto object-contain" loading="lazy" />
		</div>
		<!-- METALAC -->
		<div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition flex items-center justify-center h-24">
			<img src="/brendovi/METALAC.png" alt="METALAC" class="h-44 w-auto object-contain" loading="lazy" />
		</div>
		<!-- CAMAR -->
		<div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition flex items-center justify-center h-24">
			<img src="/brendovi/camar.jpg" alt="CAMAR" class="h-11 w-auto object-contain" loading="lazy" />
		</div>
    <!-- VOLPATO -->
		<div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition flex items-center justify-center h-24">
			<img src="/brendovi/VOLPATO.png" alt="VOLPATO" class="h-34 w-auto object-contain" loading="lazy" />
		</div>
    <!-- EUROPROFIL -->
		<div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition flex items-center justify-center h-24">
			<img src="/brendovi/EUROPROFIL.png" alt="EUROPROFIL" class="h-34 w-auto object-contain" loading="lazy" />
		</div>
    <!-- TITUS -->
		<div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition flex items-center justify-center h-24">
			<img src="/brendovi/TITUS.png" alt="TITUS" class="h-12 w-auto object-contain" loading="lazy" />
		</div>
    <!-- ITALIANA -->
		<div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition flex items-center justify-center h-24">
			<img src="/brendovi/ITALIANA.png" alt="ITALIANA" class="h-11 w-auto object-contain" loading="lazy" />
		</div>
      </div>
    </div>
         <!-- Katalog sekcija -->
    <div class="text-center mt-8 pt-8">
      <p class="text-gray-600 text-lg mb-4">
        Pregledajte cjelokupnu ponudu u našem katalogu
      </p>
      <a href="/KATALOG.pdf?inline" target="_blank" class="inline-block bg-[#4d5eab] text-white px-10 py-4 rounded-lg font-semibold hover:bg-[#3d4e8a] transition shadow-lg shadow-[#4d5eab]/30">
        KATALOG
      </a>
    </div>
  </section>

  <!-- STATISTIKE -->
<section class="py-16 bg-[#4d5eab] text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Tekst iznad brojeva -->
    <div class="text-center mb-8">
      <p class="text-white text-xl md:text-2xl font-semibold">
        Zašto baš mi?
      </p>
      <p class="text-white/60 text-sm md:text-base max-w-2xl mx-auto mt-1">
        Iskustvo, kvalitet i pouzdanost koje prepoznaju naši klijenti širom BiH.
      </p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
      <div>
        <div class="text-4xl font-bold">20+</div>
        <div class="text-sm opacity mt-1">Godina u struci</div>
      </div>
      <div>
        <div class="text-4xl font-bold">50+</div>
        <div class="text-sm opacity mt-1">Zadovoljnih firmi</div>
      </div>
      <div>
        <div class="text-4xl font-bold">100%</div>
        <div class="text-sm opacity mt-1">Kvalitet garancija</div>
      </div>
      <div>
      <div class="flex justify-center">
        <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      </div>
      <div class="text-sm opacity mt-1">Isporuka brzom poštom do 48h</div>
    </div>
    </div>
  </div>
</section>

  <!-- O NAMA SEKCIJA -->
<section id="o-nama" class="py-20 bg-white min-h-screen">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Gornji dio: Tekst lijevo, slika desno -->
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <div>
        <span class="text-[#4d5eab] font-semibold text-sm uppercase tracking-wider">O nama</span>
        <h2 class="text-4xl font-bold text-gray-900 mt-2 mb-4">Kvalitet koji traje</h2>
        <p class="text-gray-600 mb-4">
          Ambijent je porodična firma osnovana 2022. godine sa ciljem da proizvođačima namještaja i stolarskim radnjama ponudi vrhunske okove po povoljnim cijenama.
        </p>
        <p class="text-gray-600 mb-4">
          Bavimo se prodajom okova za izradu namještaja i sobnih vrata. U našoj ponudi nalaze se provjereni brendovi, a asortiman konstantno prilagođavamo potrebama tržišta.
        </p>
        <p class="text-gray-600 mb-4">
          Rad sa nama podrazumijeva sigurnost, brzu isporuku i profesionalan odnos prema svakom klijentu. Bez obzira na veličinu projekta – tu smo da vam pomognemo u odabiru pravih rješenja i da vaš rad učinimo lakšim.
        </p>
      </div>
      <div class="rounded-2xl overflow-hidden h-80">
        <img 
          src="/BLUM_SARKE.jpg" 
          alt="Ambijent - prodaja okova" 
          class="w-full h-full object-cover"
        />
      </div>
    </div>

    <!-- Donji dio: Slika lijevo, tekst desno -->
    <div class="grid md:grid-cols-2 gap-12 items-center mt-16 pt-8 border-t border-gray-100">
      <div class="rounded-2xl overflow-hidden h-80 order-1 md:order-none">
        <img 
          src="/BLANCO_SUDOPER.jpg" 
          alt="Ambijent - naša misija" 
          class="w-full h-full object-cover"
        />
      </div>
      <div class="order-2">
        <span class="text-[#4d5eab] font-semibold text-sm uppercase tracking-wider">Naša misija</span>
        <h3 class="text-2xl md:text-4xl font-bold text-gray-900 mt-2 mb-4">Zašto postojimo</h3>
        <p class="text-gray-600 mb-4">
          Misija nam je jednostavna – da vam ponudimo više od okova. To su povjerenje, podrška i rješenja koja traju.
        </p>
        <blockquote class="text-[#4d5eab] italic text-lg md:text-xl font-medium border-l-4 border-[#4d5eab] pl-4">
          "Vjerujemo da svaki detalj čini razliku. Zato biramo samo najbolje okove za vaše projekte."
        </blockquote>
      </div>
    </div>
  </div>
</section>

<!-- CTA SEKCIJA -->
<section id="cta" class="py-20 bg-gray-50">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-4xl font-bold text-gray-900 mb-4">
      Trebate kvalitetne okove?
    </h2>
    <p class="text-xl text-gray-600 mb-8">
      Kontaktirajte nas za ponudu ili savjet. Odaberite pouzdanost i profesionalnost.
    </p>
    <div class="flex flex-col sm:flex-row gap-6 justify-center">
      <a href="#kontakt-forma" class="inline-block bg-[#4d5eab] text-white px-10 py-4 rounded-lg font-semibold hover:bg-[#3d4e8a] transition shadow-lg shadow-[#4d5eab]/30">
        Zatražite ponudu
      </a>
    </div>
  </div>
</section>

  <!-- KONTAKT SEKCIJA -->
<section id="kontakt" class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <span class="text-[#4d5eab] font-semibold text-sm uppercase tracking-wider">Kontakt</span>
      <h2 class="text-4xl font-bold text-gray-900 mt-2">Tu smo za vas</h2>
      <p class="text-gray-600 mt-4 max-w-2xl mx-auto">
        Kontaktirajte nas putem telefona, emaila ili nas posjetite u našem salonu.
      </p>
    </div>

    <!-- Gornji dio: Info + Mapa -->
    <div class="grid md:grid-cols-2 gap-12 mb-16">
      <!-- Lijeva strana: Info -->
      <div>
        <div class="space-y-6">
          <!-- Adresa -->
          <div class="flex items-start gap-4">
            <svg class="w-6 h-6 text-[#4d5eab] mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <div>
              <h4 class="font-semibold text-gray-900">Adresa</h4>
              <p class="text-gray-600">Filipa Višnjića 50, Bijeljina</p>
            </div>
          </div>

          <!-- Telefon -->
          <div class="flex items-start gap-4">
            <svg class="w-6 h-6 text-[#4d5eab] mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <div>
              <h4 class="font-semibold text-gray-900">Telefon</h4>
              <p class="text-gray-600">
                <a href="tel:+38765882881" class="hover:text-[#4d5eab] transition">+387 65 882 881</a><br />
                <a href="tel:+38765668903" class="hover:text-[#4d5eab] transition">+387 65 668 903</a>
              </p>
            </div>
          </div>

          <!-- Email -->
          <div class="flex items-start gap-4">
            <svg class="w-6 h-6 text-[#4d5eab] mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <div>
              <h4 class="font-semibold text-gray-900">Email</h4>
              <p class="text-gray-600">
                <a href="mailto:ambijentbn@gmail.com" class="hover:text-[#4d5eab] transition">ambijentbn@gmail.com</a>
              </p>
            </div>
          </div>

          <!-- Radno vrijeme -->
          <div class="flex items-start gap-4">
            <svg class="w-6 h-6 text-[#4d5eab] mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <div>
              <h4 class="font-semibold text-gray-900">Radno vrijeme</h4>
              <p class="text-gray-600">Pon - Pet: 08:00 - 16:00</p>
              <p class="text-gray-600">Subota: 08:00 - 12:00</p>
              <p class="text-gray-600">Nedjelja: Zatvoreno</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Desna strana: Google Mapa -->
      <div>
        <div class="rounded-xl overflow-hidden shadow-lg h-80 md:h-full min-h-[300px]">
          <iframe 
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d5666.6685542534915!2d19.20641367591811!3d44.75359698057036!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x475be9c13a37de6d%3A0x5b04d4ec24348323!2sTR%20%22Ambijent%22%20Bijeljina!5e0!3m2!1ssr!2sba!4v1787247541850!5m2!1ssr!2sba" 
            width="100%" 
            height="100%" 
            style="border:0;" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade"
            class="w-full h-full"
            title="Google mapa - Filipa Višnjića 50, Bijeljina"
          ></iframe>
        </div>
      </div>
    </div>

  <!-- Donji dio: Kontakt forma -->
  <div class="max-w-3xl mx-auto">
    <div class="text-center mb-10">
      <h3 id="kontakt-forma" class="text-2xl font-bold text-gray-900">Pošaljite nam poruku</h3>
      <p class="text-gray-600 mt-2">Odgovaramo u najkraćem mogućem roku.</p>
    </div>
    
    <form action="https://formspree.io/f/mjybproj" method="POST" class="space-y-6" data-success="Poruka je uspješno poslana! Hvala vam na interesovanju." autocomplete="off">
      <div class="grid md:grid-cols-2 gap-6">
        <div>
          <label for="ime" class="block text-sm font-medium text-gray-700 mb-1">Ime i prezime *</label>
          <input type="text" id="ime" name="ime" placeholder="Unesite vaše ime i prezime" autocomplete="off" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-[#4d5eab] focus:border-[#4d5eab] outline-none transition" required />
        </div>
        <div>
          <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email adresa *</label>
          <input type="email" id="email" name="email" placeholder="Unesite vaš email" autocomplete="email" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-[#4d5eab] focus:border-[#4d5eab] outline-none transition" required />
        </div>
      </div>
      
      <div>
        <label for="telefon" class="block text-sm font-medium text-gray-700 mb-1">Telefon *</label>
        <input type="tel" id="telefon" name="telefon" placeholder="Unesite vaš broj telefona" autocomplete="off" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-[#4d5eab] focus:border-[#4d5eab] outline-none transition" required />
      </div>
      
      <div>
        <label for="tema" class="block text-sm font-medium text-gray-700 mb-1">Tema poruke *</label>
        <select id="tema" name="tema" autocomplete="off" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-[#4d5eab] focus:border-[#4d5eab] outline-none transition" required>
          <option value="">Odaberite temu</option>
          <option value="upit">Upit o proizvodima</option>
          <option value="narudzba">Narudžba</option>
          <option value="savjet">Savjet za odabir okova</option>
          <option value="ostalo">Ostalo</option>
        </select>
      </div>
      
      <div>
        <label for="poruka" class="block text-sm font-medium text-gray-700 mb-1">Poruka *</label>
        <textarea id="poruka" name="poruka" rows="5" placeholder="Napišite vašu poruku..." autocomplete="off" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-[#4d5eab] focus:border-[#4d5eab] outline-none transition resize-none" required></textarea>
      </div>
      
      <button type="submit" class="w-full md:w-auto bg-[#4d5eab] text-white px-10 py-3 rounded-lg font-semibold hover:bg-[#3d4e8a] transition shadow-lg shadow-[#4d5eab]/30">
        Pošaljite poruku
      </button>
    </form>
  </div>
  </div>
